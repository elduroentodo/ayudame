NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WhatsApp Business (Meta). Valores privados de servidor.
# La conexión directa requiere verificación de Tech Provider y App Review.
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_GRAPH_API_VERSION=v27.0

# Cloudflare Workers AI (variables privadas de servidor)
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Solo para desarrollo local opcional
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
